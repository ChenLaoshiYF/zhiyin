{
  "asr": {
    "model": "models/faster-whisper-large-v3-turbo",
    "device": "auto",
    "compute_type": "float16",
    "beam_size": 1,
    "language": "ru",
    "min_speech_sec": 1.5,
    "silence_sec": 1.2,
    "model_dir": "models"
  },
  "translate": {
    "backend": "hybrid",
    "local_model": "models/nllb-200-distilled-600M",
    "refine": true,
    "cloud": {
      "provider": "openai_compatible",
      "base_url": "https://api.deepseek.com",
      "api_key": "sk-你的KEY填这里",
      "model": "deepseek-v4-flash"
    }
  },
  "save_transcript": true,
  "transcript_dir": "文稿",
  "glossary": {},
  "audio": {
    "loopback_device": "auto",
    "chunk_sec": 0.1
  },
  "ui": {
    "font_size": 20,
    "font_size_zh": 20,
    "opacity": 0.9,
    "click_through": false,
    "width": 720
  }
